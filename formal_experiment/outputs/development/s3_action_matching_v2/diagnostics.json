{
  "schema_version": "s3_action_matching_v2_diagnostics@1.0.0",
  "run_id": "s3_action_matching_v2",
  "method": {
    "id": "evidence_checks_v2_action_matching",
    "scope": "action matching only"
  },
  "matching_policy": {
    "method": "s3_action_matching@2.0.0",
    "base_method": "s3_evidence_checks@1.0.0",
    "modification_scope": "action matching only",
    "exact_normalisation": "Unicode NFKC, casefold, collapse whitespace runs, strip",
    "exact_priority": "one unique exact match wins over every approximate match",
    "exact_tie": "different activity ids with identical normalised labels stay unknown",
    "object_evidence": "nominal tokens (NOUN/PROPN/NUM) minus the head token, minus any token whose lemma equals the predicate, minus verbs and auxiliaries, minus stopwords, and minus subject-like slots (nsubj/nsubjpass/csubj/npadvmod) where a mis-tagged action word lands; how many of the surviving tokens sit in an object relation (dobj/pobj/attr/oprd) is recorded as relation support",
    "tiers": {
      "exact_label": "mapped, certain",
      "exact_label_tie": "unknown (identical labels on several activities)",
      "predicate_object_agreement": "mapped: same predicate, identical object evidence, numerals and negation",
      "predicate_object_agreement_tie": "unknown (several indistinguishable equivalent candidates)",
      "object_conflict": "not mapped: same predicate with disjoint object evidence, or different numerals / negation",
      "partial_object_overlap": "unknown (partial object overlap: under-determined)",
      "frozen_similarity": "mapped through the frozen similarity backend above gamma",
      "frozen_similarity_tie": "unknown (several equally similar candidates)",
      "similarity_below_gamma": "not mapped: best similarity at or below gamma",
      "no_process_actions": "no labelled process activity to match against"
    },
    "false": [
      "no GDPR vocabulary or object list",
      "no sample-id special cases",
      "no target-label whitelist",
      "no replacement table derived from panel results",
      "no ordering by activity id to settle identical labels",
      "no use of the frozen target id inside matching"
    ]
  },
  "policy_frozen_before_panel_scoring": true,
  "definitions": {
    "correct_positive": "variant side judged violation",
    "correct_control": "original side judged satisfied",
    "v1_unknown_transitions": "of the 19 v1 unknown items, how v2 judges them now",
    "match_tier": "decision tier per requirement/endpoint, recorded in predictions.jsonl"
  },
