  "method": {
    "paper_sections": {
      "matching": "Definition 4 (Matching Score): Dr,m = rule actions -> highest-similarity process action; Or,m = rule actors -> highest-similarity process business-object/actor; matching(r,m,tau) = max( fraction of Dr,m with sim>tau, fraction of Or,m with sim>tau )",
      "missing_action": "Definition 5: action violation(r,m,gamma) = |{(ar,am) in Dr,m | sim(ar,am)<gamma}| / |Ar|",
      "incorrect_actor": "Definition 6: R = rule actors assigned to a matched activity (sim>gamma); C = process actors executing the same action; actor violation = |{r in R | exists r' in C, sim(r,r')<theta}| / |R|",
      "out_of_order": "Definition 7: Ur,m,gamma = order constraints whose both endpoints map with sim>gamma; order violation = (|Ur,m,gamma| - |satisfied order constraints (forward reachable, not backward)|) / |Ur,m,gamma|"
    },
    "thresholds": {
      "tau": 0.8,
      "tau_source": "Sun 2024 Table 9 / Table 11: most models reach highest AP/MAP at tau=0.8 (9 of 12 and 4 of 4)",
      "gamma": 0.8,
      "gamma_source": "Sun 2024 Figure 8: violation-detection precision is highest at gamma=0.8 for most models",
      "theta": 0.8,
      "theta_source": "pre-registered development setting: Sun 2024 Figure 9 reports that two of the four GDPR models reach their highest incorrect-actor precision at theta=0.8 and the other two at theta=0.7 (gamma fixed at 0.8); 0.8 is the project's fixed pre-registration, reported together with a theta sweep",
