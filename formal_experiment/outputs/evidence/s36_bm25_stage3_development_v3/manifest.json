  "method": {
    "tokenizer": "lowercase alphanumeric tokens (no stopword removal: lexical lower bound)",
    "bm25": {
      "k1": 1.5,
      "b": 0.75,
      "note": "Okapi BM25 defaults; b genuinely affects length normalisation"
    },
    "retrieval_domains": {
      "action": {
        "documents": "the process model's action labels",
        "index": "per-model action_index"
      },
      "actor": {
        "documents": "the process model's actor/pool/lane names plus business-object texts",
        "index": "per-model actor_index"
      },
      "note": "separate candidate pools per domain; actor/BO scores never reuse the action corpus"
    },
    "scoring": "candidate-specific BM25: score(query, candidate) uses the candidate's own term frequencies and length, IDF/length statistics from the domain pool",
    "normalization": "score / sum(IDF(t)*(k1+1)) over unique query terms; each term contribution IDF*tf*(k1+1)/(tf + k1*(1-b+b*dl/avgdl)) is < 1 for all tf/dl, so the result is truly in [0,1]; repeated query tokens are collapsed for the bound; empty query/candidate/pool yields 0.0",
    "tie_breaking": "best match = max score with first-seen action order (stable parsed order); duplicate labels map to the first parsed action id deterministically",
    "matching_formula": "matching_score = max(avg best rule-action BM25, avg best rule-actor BM25)",
    "violation_semantics": "mapping mirrors Sun Definitions 5-7 structure with BM25 similarity; gamma and theta DO change mappings, R/C sets, denominators and observability, so sensitivity must re-instantiate the scorer (see baseline_stage3_sensitivity.py)",
    "empty_semantics": "empty query/candidate/pool -> score 0.0, no match, never silently compliant"
  },
  "supersedes": {
    "v1": "superseded_invalid_candidate_agnostic_similarity (sim ignored candidate text; results not usable for comparison, registry active methods, or the paper)",
