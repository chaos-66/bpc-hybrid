{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2_13_s3_7_transition_readiness_v9.schema.json",
  "title": "S2.13 to S3.7 transition readiness v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "supersedes", "pipeline_state",
    "s2_11", "s2_12", "s2_13", "stage3", "gold_rule_records",
    "oracle_isolation_run", "historical_transition_verifiers",
    "authorization", "safety"
  ],
  "properties": {
    "schema_version": {"const": "s2_13_s3_7_transition_readiness@9.0.0"},
    "report_id": {"const": "s2_13_s3_7_transition_readiness_v9"},
    "supersedes": {"type": "array", "minItems": 9},
    "pipeline_state": {"type": "object"},
    "s2_11": {"type": "object"},
    "s2_12": {"type": "object"},
    "s2_13": {"type": "object"},
    "stage3": {"type": "object"},
    "gold_rule_records": {
      "type": "object",
      "required": ["exist", "verifier_verified", "counts", "bindings"],
      "properties": {
        "exist": {"const": true},
        "verifier_verified": {"const": true},
        "counts": {"type": "object"},
        "bindings": {"type": "object"}
      }
    },
    "oracle_isolation_run": {"type": "object"},
    "historical_transition_verifiers": {"type": "object"},
    "authorization": {"type": "object"},
    "safety": {"type": "object"}
  }
}
