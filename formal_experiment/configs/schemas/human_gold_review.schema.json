{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human_gold_review.schema.json",
  "title": "EStG 150 human text and semantic review record",
  "type": "object",
  "required": ["schema_version", "sample_id", "source", "text_review", "clauses", "annotation_review", "do_not_auto_score"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "sample_id": {"type": "string", "pattern": "^estg_[0-9]{6}$"},
    "source": {
      "type": "object",
      "required": ["record_id", "source_name", "source_text_de_ocr", "candidate_text_en", "selection_rank", "selection_policy", "provenance_path"],
      "properties": {
        "record_id": {"type": "integer"},
        "source_name": {"type": "string"},
        "source_text_de_ocr": {"type": "string"},
        "candidate_text_en": {"type": "string"},
        "selection_rank": {"type": "integer", "minimum": 1, "maximum": 150},
        "selection_policy": {"type": "string"},
        "provenance_path": {"type": "string"}
      }
    },
    "text_review": {
      "type": "object",
      "required": ["status", "reviewer", "reviewed_at", "corrected_text_de", "approved_text_en", "notes"],
      "properties": {
        "status": {"enum": ["needs_review", "approved", "rejected"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "corrected_text_de": {"type": ["string", "null"]},
        "approved_text_en": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clause_id", "clause_span", "modality", "actors", "actions", "conditions", "constraints", "exceptions", "actor_action_map", "order_relations"],
        "properties": {
          "clause_id": {"type": "string"},
          "clause_span": {"$ref": "#/$defs/span"},
          "modality": {
            "type": "object",
            "required": ["label", "evidence"],
            "properties": {
              "label": {"enum": ["obligation", "prohibition", "permission", "definition"]},
              "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}}
            }
          },
          "actors": {"type": "array", "items": {"$ref": "#/$defs/identifiedSpan"}},
          "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifiedSpan"}},
          "conditions": {"type": "array", "items": {"$ref": "#/$defs/identifiedSpan"}},
          "constraints": {"type": "array", "items": {"$ref": "#/$defs/identifiedSpan"}},
          "exceptions": {"type": "array", "items": {"$ref": "#/$defs/identifiedSpan"}},
          "actor_action_map": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["actor_id", "action_id"],
              "properties": {
                "actor_id": {"type": ["string", "null"]},
                "action_id": {"type": "string"}
              }
            }
          },
          "order_relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["before_action_id", "after_action_id", "evidence"],
              "properties": {
                "before_action_id": {"type": "string"},
                "after_action_id": {"type": "string"},
                "evidence": {"type": "array", "items": {"$ref": "#/$defs/span"}}
              }
            }
          }
        }
      }
    },
    "annotation_review": {
      "type": "object",
      "required": ["status", "reviewer", "reviewed_at", "confidence", "no_normative_clause_reason", "notes"],
      "properties": {
        "status": {"enum": ["needs_review", "reviewed", "adjudicated", "rejected"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "confidence": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "no_normative_clause_reason": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "do_not_auto_score": {"const": true}
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["value", "start", "end"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "identifiedSpan": {
      "allOf": [
        {"$ref": "#/$defs/span"},
        {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}
      ]
    }
  }
}
