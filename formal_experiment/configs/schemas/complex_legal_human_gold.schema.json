{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "complex_legal_human_gold.schema.json",
  "title": "S2.11 complex legal human-Gold review",
  "type": "object",
  "required": ["schema_version", "dataset_id", "membership_sha256", "status", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "complex_legal_human_gold_review@1.0.0"},
    "dataset_id": {"const": "gdpr_2016_679_articles_5_50_seeded50_v1"},
    "membership_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {
      "enum": [
        "template_pending_human_annotation",
        "human_annotation_in_progress",
        "human_adjudicated_frozen"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "decision": {
      "enum": ["unreviewed", "accepted", "edited", "rejected", "needs_adjudication"]
    },
    "decisions": {
      "type": "object",
      "required": [
        "source_verified",
        "clause_segmentation",
        "modality",
        "actors",
        "actions",
        "conditions",
        "constraints",
        "exceptions",
        "actor_action_map",
        "order_relations"
      ],
      "additionalProperties": false,
      "properties": {
        "source_verified": {"$ref": "#/$defs/decision"},
        "clause_segmentation": {"$ref": "#/$defs/decision"},
        "modality": {"$ref": "#/$defs/decision"},
        "actors": {"$ref": "#/$defs/decision"},
        "actions": {"$ref": "#/$defs/decision"},
        "conditions": {"$ref": "#/$defs/decision"},
        "constraints": {"$ref": "#/$defs/decision"},
        "exceptions": {"$ref": "#/$defs/decision"},
        "actor_action_map": {"$ref": "#/$defs/decision"},
        "order_relations": {"$ref": "#/$defs/decision"}
      }
    },
    "canonicalGold": {
      "type": "object",
      "required": ["clauses"],
      "additionalProperties": false,
      "properties": {
        "clauses": {"type": "array"},
        "unsupported_or_ambiguous": {"type": "array"}
      }
    },
    "record": {
      "type": "object",
      "required": [
        "sample_id",
        "source_locator",
        "source_text",
        "source_text_sha256",
        "review_state",
        "record_decision",
        "canonical_gold",
        "decisions",
        "reviewer",
        "reviewed_at",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "sample_id": {"type": "string", "pattern": "^gdpr_2016_679_art[0-9]{3}_par[0-9]{3}$"},
        "source_locator": {"type": "string", "minLength": 1},
        "source_text": {"type": "string", "minLength": 1},
        "source_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_state": {"enum": ["needs_review", "reviewed", "adjudicated"]},
        "record_decision": {
          "enum": [
            "unreviewed",
            "canonical_rule_present",
            "no_canonical_rule",
            "source_error",
            "needs_adjudication"
          ]
        },
        "canonical_gold": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/canonicalGold"}]},
        "decisions": {"$ref": "#/$defs/decisions"},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
