{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2_11_formal_gold_v1.schema.json",
  "title": "S2.11 complex-corpus formal Gold v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "publication_status",
    "claim",
    "provenance",
    "bindings",
    "membership",
    "records",
    "containment",
    "zero_api"
  ],
  "properties": {
    "schema_version": {"const": "s2_11_formal_gold@1.0.0"},
    "dataset_id": {"const": "s2_11_barrientos_complex_corpus_36_v1"},
    "publication_status": {"const": "formal_frozen_published"},
    "claim": {"const": "LLM-assisted, user-adjudicated Gold"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_source",
        "adjudication",
        "reviewer",
        "revisions",
        "independent_from_scratch_expert_annotation",
        "derivation"
      ],
      "properties": {
        "proposal_source": {"const": "deepseek_offline_proposal_v3"},
        "adjudication": {"const": "user_batch_confirmation"},
        "reviewer": {"const": "hyc"},
        "revisions": {"const": "none"},
        "independent_from_scratch_expert_annotation": {"const": false},
        "derivation": {
          "const": "canonical decisions copied without adding, inferring, or rewriting any label, span, mapping, or relation"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmation_event",
        "proposal_report",
        "proposal_file",
        "decisions",
        "membership",
        "g0_5_frozen_config"
      ],
      "properties": {
        "confirmation_event": {"$ref": "#/$defs/fileBindingWithInstruction"},
        "proposal_report": {"$ref": "#/$defs/fileBinding"},
        "proposal_file": {"$ref": "#/$defs/fileBinding"},
        "decisions": {"$ref": "#/$defs/fileBinding"},
        "membership": {"$ref": "#/$defs/fileBinding"},
        "g0_5_frozen_config": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory", "objective_exclusions", "published_records", "sample_ids"],
      "properties": {
        "inventory": {"const": 40},
        "objective_exclusions": {"const": 4},
        "published_records": {"const": 36},
        "sample_ids": {
          "type": "array",
          "minItems": 36,
          "maxItems": 36,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {"$ref": "#/$defs/record"}
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_text_committed", "source_access", "redistribution"],
      "properties": {
        "raw_text_committed": {"const": false},
        "source_access": {"const": "local_read_only_hash_bound"},
        "redistribution": {"const": "forbidden_license_unknown"}
      }
    },
    "zero_api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_llm_api_calls"],
      "properties": {"new_llm_api_calls": {"const": 0}}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileBindingWithInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "user_instruction_utf8_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "user_instruction_utf8_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "source", "canonical"],
      "properties": {
        "sample_id": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "file_sha256", "text_sha256", "text_byte_size"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "text_sha256": {"$ref": "#/$defs/sha256"},
            "text_byte_size": {"type": "integer", "minimum": 1}
          }
        },
        "canonical": {"$ref": "#/$defs/canonical"}
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clauses", "actor_action_map", "order_relations"],
      "properties": {
        "clauses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clause"}},
        "actor_action_map": {"type": "array", "items": {"$ref": "#/$defs/actorAction"}},
        "order_relations": {"type": "array", "items": {"$ref": "#/$defs/orderRelation"}}
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause_id", "clause_span", "modality", "actor", "action", "condition", "constraint", "exception"],
      "properties": {
        "clause_id": {"type": "string", "minLength": 1},
        "clause_span": {"$ref": "#/$defs/coordinateSpan"},
        "modality": {"$ref": "#/$defs/modality"},
        "actor": {"$ref": "#/$defs/ordinaryField"},
        "action": {"$ref": "#/$defs/ordinaryField"},
        "condition": {"$ref": "#/$defs/ordinaryField"},
        "constraint": {"$ref": "#/$defs/ordinaryField"},
        "exception": {"$ref": "#/$defs/ordinaryField"}
      }
    },
    "coordinateSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "identifiedSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "modality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "label", "evidence"],
      "properties": {
        "status": {"enum": ["absent", "present"]},
        "label": {"type": ["string", "null"], "enum": [null, "obligation", "permission", "prohibition", "definition"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/identifiedSpan"}}
      }
    },
    "ordinaryField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "spans"],
      "properties": {
        "status": {"enum": ["absent", "present"]},
        "spans": {"type": "array", "items": {"$ref": "#/$defs/identifiedSpan"}}
      }
    },
    "actorAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_span_id", "action_span_id"],
      "properties": {
        "actor_span_id": {"type": "string", "minLength": 1},
        "action_span_id": {"type": "string", "minLength": 1}
      }
    },
    "orderRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_span_id", "after_span_id"],
      "properties": {
        "before_span_id": {"type": "string", "minLength": 1},
        "after_span_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
