  "labels": ["definition", "obligation", "permission", "prohibition"],
  "methods": {
    "train_majority": {
      "type": "unsupervised_prediction_rule_with_train_only_label_frequency",
      "tie_break": "configured_label_order",
      "expected_train_majority": "obligation"
    },
    "german_keyword": {
      "type": "fixed_language_rule_lower_bound",
      "normalization": "unicode_casefold",
      "precedence": ["prohibition", "permission", "obligation", "definition"],
      "default": "train_majority",
      "patterns": {
        "prohibition": [
          "\\bdarf(?:en)?\\s+(?:nicht|kein\\w*)\\b",
          "\\bnicht\\s+zulässig\\b",
          "\\bunzulässig\\b",
          "\\bverboten\\b"
        ],
        "permission": [
          "\\bdarf\\b",
          "\\bdürfen\\b",
          "\\bkann\\b",
          "\\bkönnen\\b",
          "\\bist\\s+berechtigt\\b"
        ],
        "obligation": [
          "\\bmuss\\b",
          "\\bmüssen\\b",
          "\\bhat\\b.{0,120}\\bzu\\b",
          "\\bhaben\\b.{0,120}\\bzu\\b",
          "\\bist\\b.{0,120}\\bzu\\b",
          "\\bsind\\b.{0,120}\\bzu\\b",
          "\\bverpflichtet\\b"
        ],
        "definition": [
          "\\bgilt\\b",
          "\\bgelten\\b",
          "\\bbedeutet\\b",
          "\\bim\\s+sinne\\b",
          "\\bist\\b",
          "\\bsind\\b"
        ]
      }
    },
    "word_ngram_multinomial_nb": {
      "type": "supervised_non_neural_baseline",
      "tokenization": "unicode_word_regex_[^\\W_]+_after_casefold",
      "ngram_range": [1, 2],
      "feature_value": "term_frequency",
      "min_document_frequency": 2,
      "max_features": null,
      "likelihood_smoothing_alpha": 1.0,
      "class_prior": "empirical_with_add_one_smoothing",
      "hyperparameter_search": false,
      "external_ml_dependency": false,
      "tie_break": "configured_label_order"
    }
  },
  "metrics": {
    "primary": "macro_f1",
    "secondary": ["accuracy", "per_class_precision_recall_f1_support", "confusion_matrix"],
    "macro_f1_includes_zero_for_missing_predictions": true,
    "row_level_predictions_may_be_persisted": false
  },
  "test_execution_disclosure": {
    "development_smoke_accessed_test_labels_before_versioned_run": true,
