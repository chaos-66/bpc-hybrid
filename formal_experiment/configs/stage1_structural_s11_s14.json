      "exclusiveGateway",
      "parallelGateway",
      "inclusiveGateway",
      "complexGateway",
      "eventBasedGateway"
    ],
    "containers": ["participant", "lane", "sequenceFlow"]
  },
  "determinism": {
    "record_arrays": "ascending_id",
