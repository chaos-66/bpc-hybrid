    "input_extension": ".bpmn",
    "canonical_namespace": "http://www.omg.org/spec/BPMN/20100524/MODEL",
    "namespace_handling": "local_name_parse_namespace_recorded",
    "process_selection": "exactly_one_process_per_input",
    "subprocess_handling": "opaque_activity_no_internal_flattening",
    "label_semantics": "preserve_original_labels_only",
    "xml_doctype_or_entity_allowed": false,
    "max_input_bytes": 20971520
  },
  "supported_elements": {
    "activities": [
      "task",
      "userTask",
      "serviceTask",
      "sendTask",
      "receiveTask",
      "manualTask",
      "businessRuleTask",
      "scriptTask",
      "subProcess",
      "callActivity"
