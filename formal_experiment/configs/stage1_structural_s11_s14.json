    "cycle_detection": "nodes_that_can_reach_themselves_via_one_or_more_edges",
    "unreachable_nodes": "flow_nodes_not_reachable_from_any_start_event_including_start_events_as_reachable",
    "branching_gateway": "gateway_outdegree_greater_than_one",
    "parallel_split": "parallelGateway_outdegree_greater_than_one",
    "parallel_join": "parallelGateway_indegree_greater_than_one"
  },
  "safety": {
    "fixture_scope": "synthetic_only",
    "formal_bpmn_read": false,
    "human_gold_read_or_modified": false,
    "llm_api_called": false,
    "network_called": false,
    "performance_evaluation": false,
    "formal_process_records_written": false,
    "no_overwrite": true
  },
  "claim_boundary": "S1.1/S1.2/S1.4 freeze and verify a canonical Process Record schema, deterministic BPMN structural parsing, lane/pool binding, direct flow, reachability, activity order, branch/parallel classification, cycle detection, and unreachable-node accounting on synthetic BPMN only. This is not label-semantic evaluation, human Gold, formal BPMN evaluation, or Stage 1 performance evidence."
