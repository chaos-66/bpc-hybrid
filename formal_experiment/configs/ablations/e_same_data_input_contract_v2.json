        "sample_id": "emergencies_scenario/r4/v2",
        "scenario": "emergencies_scenario",
        "record_id": "r4",
        "version": 2,
        "text": "If the doctor does not authorize skipping blood analysis, the analysis test should happen before the surgery.",
