        "sample_id": "emergencies_scenario/r2/v1",
        "scenario": "emergencies_scenario",
        "record_id": "r2",
        "version": 1,
        "text": "Before a surgical intervention, the nurse must obtain the patient’s consent. After obtaining consent, the nurse must conduct a ``time out'' procedure",
        "bindings": {
          "source_file": "references/barrientos_2026/artifact_input/requirements/emergencies_scenario/emergencies_scenario.json",
          "source_file_sha256": "c0ec30e69e082f686edbe813e8c8de071ea2150cb049bbb56235badd44ce9684",
