        "sample_id": "emergencies_scenario/r3/v1",
        "scenario": "emergencies_scenario",
        "record_id": "r3",
        "version": 1,
        "text": "If the patient is over 65, a nurse must approve discharge before the patient is discharged, and approval must occur within 24 hours prior to discharge. The rule is valid from 2024 to 2030.",
        "bindings": {
          "source_file": "references/barrientos_2026/artifact_input/requirements/emergencies_scenario/emergencies_scenario.json",
          "source_file_sha256": "c0ec30e69e082f686edbe813e8c8de071ea2150cb049bbb56235badd44ce9684",
