        "sample_id": "emergencies_scenario/r3/v2",
        "scenario": "emergencies_scenario",
        "record_id": "r3",
        "version": 2,
        "text": "If the patient is over 65 or has more than 5 medications, a doctor must approve discharge before the patient is discharged. The rule is valid from 2025 to 2031.",
        "bindings": {
          "source_file": "references/barrientos_2026/artifact_input/requirements/emergencies_scenario/emergencies_scenario.json",
