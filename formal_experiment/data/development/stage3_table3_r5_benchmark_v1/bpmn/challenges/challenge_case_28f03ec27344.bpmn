<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions" targetNamespace="urn:bpc:table3:r5:challenge">
  <collaboration id="Collaboration">
    <participant id="Participant" name="Controller" processRef="Process" />
  </collaboration>
  <process id="Process" name="Controller" isExecutable="false">
    <laneSet id="LaneSet">
      <lane id="Lane_Actor" name="Controller">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>Gateway_Applicability</flowNodeRef>
        <flowNodeRef>Activity_0</flowNodeRef>
        <flowNodeRef>Activity_1</flowNodeRef>
        <flowNodeRef>Activity_2</flowNodeRef>
        <flowNodeRef>End</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="Indirect collection requires information within one month. (condition/exception true)" />
    <exclusiveGateway id="Gateway_Applicability" name="exception" />
    <task id="Activity_0" name="Obtain personal data from a source other than the data subject" />
    <task id="Activity_1" name="Provide required indirect-collection information to the data subject" />
    <task id="Activity_2" name="Record the one-month response deadline" />
    <endEvent id="End" />
    <sequenceFlow id="Flow_Start_Gateway" sourceRef="Start" targetRef="Gateway_Applicability" />
    <sequenceFlow id="Flow_Activity_0_to_1" sourceRef="Activity_0" targetRef="Activity_1" />
    <sequenceFlow id="Flow_Activity_1_to_2" sourceRef="Activity_1" targetRef="Activity_2" />
    <sequenceFlow id="Flow_Activity_2_End" sourceRef="Activity_2" targetRef="End" />
    <sequenceFlow id="Flow_Gateway_Activity_0" sourceRef="Gateway_Applicability" targetRef="Activity_0" />
  </process>
</definitions>
