<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions" targetNamespace="urn:bpc:table3:r5:v1">
  <collaboration id="Collaboration">
    <participant id="Participant" name="Controller" processRef="Process" />
  </collaboration>
  <process id="Process" name="Controller" isExecutable="false">
    <laneSet id="LaneSet">
      <lane id="Lane_Actor" name="Controller">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>Gateway_Applicability</flowNodeRef>
        <flowNodeRef>Activity_1</flowNodeRef>
        <flowNodeRef>Activity_0</flowNodeRef>
        <flowNodeRef>Activity_2</flowNodeRef>
        <flowNodeRef>End</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="The controller must notify recipients of rectification, erasure, or restriction." />
    <exclusiveGateway id="Gateway_Applicability" name="Assess applicable condition" />
    <task id="Activity_1" name="Communicate the change to each recipient of the personal data" />
    <task id="Activity_0" name="Carry out rectification, erasure, or restriction" />
    <task id="Activity_2" name="Inform the data subject about those recipients on request" />
    <endEvent id="End" />
    <sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Gateway_Applicability" />
    <sequenceFlow id="Flow_1" sourceRef="Gateway_Applicability" targetRef="Activity_1">
      <conditionExpression>applicability_condition == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_2" sourceRef="Activity_1" targetRef="Activity_0" />
    <sequenceFlow id="Flow_3" sourceRef="Activity_0" targetRef="Activity_2" />
    <sequenceFlow id="Flow_4" sourceRef="Activity_2" targetRef="End" />
  </process>
</definitions>
