      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_gw_portability_choice" bpmnElement="sun10_gw_portability_choice" isMarkerVisible="true">
        <dc:Bounds x="602" y="437" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_assign_new_number" bpmnElement="sun10_assign_new_number">
