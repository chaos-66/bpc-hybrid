      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_gw_parallel_payment_store" bpmnElement="sun10_gw_parallel_payment_store">
        <dc:Bounds x="1032" y="437" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_request_payment" bpmnElement="sun10_request_payment">
        <dc:Bounds x="1099" y="428" width="96" height="58"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_payment_received" bpmnElement="sun10_payment_received">
        <dc:Bounds x="1225" y="439" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_send_sim_card" bpmnElement="sun10_send_sim_card">
        <dc:Bounds x="1290" y="428" width="96" height="58"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_ask_old_number" bpmnElement="sun10_ask_old_number">
        <dc:Bounds x="573" y="530" width="98" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_ask_portability_third_party" bpmnElement="sun10_ask_portability_third_party">
        <dc:Bounds x="689" y="530" width="119" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_gw_portability_result" bpmnElement="sun10_gw_portability_result" isMarkerVisible="true">
        <dc:Bounds x="832" y="538" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_not_granted_end" bpmnElement="sun10_not_granted_end">
        <dc:Bounds x="933" y="540" width="42" height="42"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_store_data" bpmnElement="sun10_store_data">
        <dc:Bounds x="1178" y="527" width="98" height="54"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_receive_sim_card" bpmnElement="sun10_receive_sim_card">
        <dc:Bounds x="1290" y="287" width="96" height="58"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_activate_sim_card" bpmnElement="sun10_activate_sim_card">
        <dc:Bounds x="1426" y="287" width="96" height="58"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_customer_end" bpmnElement="sun10_customer_end">
        <dc:Bounds x="1562" y="298" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_personal_data" bpmnElement="sun10_personal_data">
        <dc:Bounds x="395" y="617" width="30" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sun10_shape_data_store" bpmnElement="sun10_data_store">
        <dc:Bounds x="1265" y="615" width="58" height="45"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="sun10_edge_flow_01" bpmnElement="sun10_flow_01_new_client_to_request_data">
        <di:waypoint x="236" y="457"/>
        <di:waypoint x="272" y="457"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_02" bpmnElement="sun10_flow_02_request_data_to_data_received">
        <di:waypoint x="371" y="457"/>
        <di:waypoint x="395" y="457"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_03" bpmnElement="sun10_flow_03_data_received_to_ask_portability">
        <di:waypoint x="431" y="457"/>
        <di:waypoint x="495" y="457"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_04" bpmnElement="sun10_flow_04_ask_portability_to_portability_choice">
        <di:waypoint x="577" y="457"/>
        <di:waypoint x="602" y="457"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_05" bpmnElement="sun10_flow_05_not_requested_to_assign_new_number">
        <di:waypoint x="642" y="457"/>
        <di:waypoint x="703" y="457"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_06" bpmnElement="sun10_flow_06_requested_to_ask_old_number">
        <di:waypoint x="622" y="477"/>
        <di:waypoint x="622" y="530"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_07" bpmnElement="sun10_flow_07_ask_old_number_to_third_party">
        <di:waypoint x="671" y="558"/>
        <di:waypoint x="689" y="558"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_08" bpmnElement="sun10_flow_08_third_party_to_portability_result">
        <di:waypoint x="808" y="558"/>
        <di:waypoint x="832" y="558"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_09" bpmnElement="sun10_flow_09_granted_to_portability_join">
        <di:waypoint x="852" y="538"/>
        <di:waypoint x="852" y="477"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_10" bpmnElement="sun10_flow_10_not_granted_to_end">
        <di:waypoint x="872" y="558"/>
        <di:waypoint x="933" y="558"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_11" bpmnElement="sun10_flow_11_assign_new_number_to_join">
        <di:waypoint x="799" y="457"/>
        <di:waypoint x="832" y="457"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_12" bpmnElement="sun10_flow_12_join_to_sign_contract">
        <di:waypoint x="872" y="457"/>
        <di:waypoint x="903" y="457"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_13" bpmnElement="sun10_flow_13_sign_contract_to_parallel">
        <di:waypoint x="1003" y="457"/>
        <di:waypoint x="1032" y="457"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_14" bpmnElement="sun10_flow_14_parallel_to_request_payment">
        <di:waypoint x="1072" y="457"/>
        <di:waypoint x="1099" y="457"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_15" bpmnElement="sun10_flow_15_parallel_to_store_data">
        <di:waypoint x="1052" y="477"/>
        <di:waypoint x="1052" y="554"/>
        <di:waypoint x="1178" y="554"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_16" bpmnElement="sun10_flow_16_request_payment_to_payment_received">
        <di:waypoint x="1195" y="457"/>
        <di:waypoint x="1225" y="457"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sun10_edge_flow_17" bpmnElement="sun10_flow_17_payment_received_to_send_sim_card">
        <di:waypoint x="1261" y="457"/>
