<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions" targetNamespace="urn:bpc:reconstruction:v4">
  <collaboration id="Collaboration">
    <participant id="Participant" name="Controller" processRef="Process" />
  </collaboration>
  <process id="Process" name="Controller" isExecutable="false">
    <startEvent id="Start" name="High-risk processing proposed; data protection impact assessment required" />
    <task id="Activity_0" name="Describe the envisaged high-risk processing" />
    <task id="Activity_1" name="Carry out the data protection impact assessment of the envisaged processing" />
    <task id="Activity_2" name="Begin the assessed processing operations" />
    <task id="Activity_3" name="Store the assessment reference" />
    <endEvent id="End" />
    <sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Activity_0" />
    <sequenceFlow id="Flow_1" sourceRef="Activity_0" targetRef="Activity_1" />
    <sequenceFlow id="Flow_2" sourceRef="Activity_1" targetRef="Activity_2" />
    <sequenceFlow id="Flow_3" sourceRef="Activity_2" targetRef="Activity_3" />
    <sequenceFlow id="Flow_4" sourceRef="Activity_3" targetRef="End" />
  </process>
</definitions>
