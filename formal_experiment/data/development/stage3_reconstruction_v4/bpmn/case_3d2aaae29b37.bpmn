<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions" targetNamespace="urn:bpc:reconstruction:v4">
  <collaboration id="Collaboration">
    <participant id="Participant" name="Data subject" processRef="Process" />
  </collaboration>
  <process id="Process" name="Data subject" isExecutable="false">
    <startEvent id="Start" name="Indirect collection completed; new purpose proposed; no transparency exemption applies" />
    <task id="Activity_0" name="Review the proposed secondary use of third-party data" />
    <task id="Activity_1" name="Provide the data subject with the other purpose and relevant additional information" />
    <task id="Activity_2" name="Further process the personal data for the other purpose" />
    <task id="Activity_3" name="Log the completed secondary use" />
    <endEvent id="End" />
    <sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Activity_0" />
    <sequenceFlow id="Flow_1" sourceRef="Activity_0" targetRef="Activity_1" />
    <sequenceFlow id="Flow_2" sourceRef="Activity_1" targetRef="Activity_2" />
    <sequenceFlow id="Flow_3" sourceRef="Activity_2" targetRef="Activity_3" />
    <sequenceFlow id="Flow_4" sourceRef="Activity_3" targetRef="End" />
  </process>
</definitions>
