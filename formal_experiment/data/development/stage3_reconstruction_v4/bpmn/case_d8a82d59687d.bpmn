<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions" targetNamespace="urn:bpc:reconstruction:v4">
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Participant" name="Controller" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:startEvent id="Start" name="High-risk processing proposed; data protection impact assessment required" />
    <bpmn:task id="Activity_0" name="Describe the envisaged high-risk processing" />
    <bpmn:task id="Activity_2" name="Begin the assessed processing operations" />
    <bpmn:task id="Activity_3" name="Store the assessment reference" />
    <bpmn:endEvent id="End" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Activity_0" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Activity_0" targetRef="Activity_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_2" targetRef="Activity_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_3" targetRef="End" />
  </bpmn:process>
</bpmn:definitions>
