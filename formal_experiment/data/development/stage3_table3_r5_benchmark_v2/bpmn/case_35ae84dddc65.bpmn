<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions" targetNamespace="urn:bpc:table3:r5:v1">
  <collaboration id="Collaboration">
    <participant id="Participant" name="Data subject" processRef="Process" />
  </collaboration>
  <process id="Process" name="Data subject" isExecutable="false">
    <laneSet id="LaneSet">
      <lane id="Lane_Actor" name="Data subject">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>Gateway_Applicability</flowNodeRef>
        <flowNodeRef>Activity_0</flowNodeRef>
        <flowNodeRef>Activity_1</flowNodeRef>
        <flowNodeRef>Activity_2</flowNodeRef>
        <flowNodeRef>End</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="Prior consultation is required when high residual risk remains." />
    <exclusiveGateway id="Gateway_Applicability" name="Assess applicable condition" />
    <task id="Activity_0" name="Review the DPIA indicating high residual risk" />
    <task id="Activity_1" name="Consult the supervisory authority about the proposed processing" />
    <task id="Activity_2" name="Start the proposed processing" />
    <endEvent id="End" />
    <sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Gateway_Applicability" />
    <sequenceFlow id="Flow_1" sourceRef="Gateway_Applicability" targetRef="Activity_0">
      <conditionExpression>applicability_condition == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_2" sourceRef="Activity_0" targetRef="Activity_1" />
    <sequenceFlow id="Flow_3" sourceRef="Activity_1" targetRef="Activity_2" />
    <sequenceFlow id="Flow_4" sourceRef="Activity_2" targetRef="End" />
  </process>
</definitions>
