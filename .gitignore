# Local provenance stores (documented, read-only, and too large for normal Git)
archive/
references/

# S2.1-A: official Sun modality ZIP, extracted members, and any
# S2.1-B derived artifacts MUST NOT enter Git history. License is
# unknown_pending_confirmation; user authorization on 2026-07-15 explicitly
# forbids re-distribution. The directory-level .gitignore inside raw/ is
# the authoritative copy; the entries below are belt-and-suspenders.
formal_experiment/data/development/sun_modality/raw/**
!formal_experiment/data/development/sun_modality/raw/.gitignore
formal_experiment/data/development/sun_modality/_extract/

# Keep only frozen formal reports versionable; development reports stay local
!formal_experiment/outputs/
formal_experiment/outputs/*
!formal_experiment/outputs/reports/
!formal_experiment/outputs/reports/**

# Stage 3 evidence capsules (S3.4/S3.5/S3.6, 2026-08-08): committable
# versioned evidence (manifest/config/predictions/evaluation/sensitivity/
# error analysis/export index/comparison) for a fresh-clone verification.
!formal_experiment/outputs/evidence/
!formal_experiment/outputs/evidence/**

# B0-R1-E2 (2026-08-04): narrow allowlist for the only versioned
# development re-evaluation output directory. Everything else under
# outputs/development stays ignored.
!formal_experiment/outputs/development/
formal_experiment/outputs/development/*

# S1.5 (2026-08-11): versioned human-adjudication evidence assets for the
# GDPR-7 review surface (decision_v1.json / manifest.json / import record).
!formal_experiment/outputs/development/human_review/
formal_experiment/outputs/development/human_review/*
!formal_experiment/outputs/development/human_review/stage1_adjudications/
!formal_experiment/outputs/development/human_review/stage1_adjudications/*
!formal_experiment/outputs/development/human_review/stage1_adjudications/*/
!formal_experiment/outputs/development/human_review/stage1_adjudications/*/*
!formal_experiment/outputs/development/s27_estg150_b0_v10a_vs_r1a_c3_sun_literal_v2_hist56d_v1/
!formal_experiment/outputs/development/s27_estg150_b0_v10a_vs_r1a_c3_sun_literal_v2_hist56d_v1/*

# B0-R1-ACTION (2026-08-04): narrow allowlist for the registered
# action-fix development run output directory (real B0 run on the
# historical 56d2b03 snapshot).
!formal_experiment/outputs/development/s27_estg150_b0_enhanced_v10a_r1b_actionfix_hist56d_v1/
!formal_experiment/outputs/development/s27_estg150_b0_enhanced_v10a_r1b_actionfix_hist56d_v1/*

# B0-R1-SCOPE-DISAMBIG (2026-08-04): narrow allowlist for the registered
# C2 candidate run output directory (measured negative, candidate rejected;
# artifacts kept as evidence).
!formal_experiment/outputs/development/s27_estg150_b0_enhanced_v10a_r1b_scope_disambig_hist56d_v1/
!formal_experiment/outputs/development/s27_estg150_b0_enhanced_v10a_r1b_scope_disambig_hist56d_v1/*

# B0-R1-ALIGN (2026-08-04): narrow allowlist for the registered
# DE<->EN cue-validation run output directory.
!formal_experiment/outputs/development/s27_estg150_b0_enhanced_v10a_r1b_align_hist56d_v1/
!formal_experiment/outputs/development/s27_estg150_b0_enhanced_v10a_r1b_align_hist56d_v1/*

# B0-R1-ACTOR (2026-08-04): narrow allowlist for the registered
# actor-recovery run output directory (positive delta, kept).
!formal_experiment/outputs/development/s27_estg150_b0_enhanced_v10a_r1b_actor_hist56d_v2/
!formal_experiment/outputs/development/s27_estg150_b0_enhanced_v10a_r1b_actor_hist56d_v2/*

# B0-R3 snapshot (2026-08-04): narrow allowlist for the formal-snapshot run
